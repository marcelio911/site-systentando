{
  "name": "systentando.vite.app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "pre:deploy": "npm ci && yarn build",
    "deploy": "yarn build && firebase deploy",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "transform": "tsc init",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && yarn install && yarn dev",
    "compile-sass": "sass src/assets/scss/paper-kit.scss src/assets/css/paper-kit.css",
    "minify-sass": "sass src/assets/scss/paper-kit.scss src/assets/css/paper-kit.min.css --style compressed"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "classnames": "2.3.2",
    "clsx": "^2.1.0",
    "firebase": "^10.7.2",
    "lucide-react": "^0.317.0",
    "moment": "2.29.4",
    "nouislider": "15.4.0",
    "react": "^18.2.0",
    "react-datetime": "3.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.11.1",
    "react-scripts": "5.0.1",
    "reactstrap": "8.10.0",
    "sass": "1.62.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "optionalDependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.10",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.17",
    "bootstrap": "4.6.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.13"
  },
  "peerDependencies": {
    "react": ">=16.0.0",
    "react-dom": ">=16.0.0"
  },
  "overrides": {
    "svgo": "3.0.2"
  },
  "main": "src/assets/scss/paper-kit.scss",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marcelio911/site.systentando/issues"
  },
  "homepage": "https://systentando.com/#/index"
}
